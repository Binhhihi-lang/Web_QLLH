                  "    pm.expect(conCho.length).to.be.above(0);",
                  "});",
                  "const day = data.filter(l => l.con_cho === 0);",
                  "console.log('Lớp đã đầy:', day.length, '/', data.length);",
                  "if (conCho.length > 0) pm.collectionVariables.set('lop_hp_id', conCho[0].id);"
                ]
              }
            }
