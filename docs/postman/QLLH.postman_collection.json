                "exec": [
                  "pm.test('Đăng nhập thành công (200)', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Có token trong data', () => {",
                  "    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Vai trò là ADMIN', () => {",
                  "    pm.expect(body.data.nguoi_dung.vai_tro).to.eql('ADMIN');",
                  "});",
                  "",
                  "// Lưu token cho các request sau.",
                  "pm.collectionVariables.set('token', body.data.token);",
                  "console.log('Đã lưu token:', body.data.token.substring(0, 20) + '...');"
                ]
